{
  "metadata": [
    {
      "src": [
        {
          "src": "../YamaEngine",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "../docs/**.md"
        ]
      }
    ],
    "output": "../docs/api",
    "template": [
      "default"
    ]
  }
}
