<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ShanyuAccentBrush" Color="#FF4A90E2"/>
    <SolidColorBrush x:Key="ShanyuBackgroundBrush" Color="#FF1A1A1E"/>
    <SolidColorBrush x:Key="ShanyuPanelBrush" Color="#FF25252A"/>
    <SolidColorBrush x:Key="ShanyuBorderBrush" Color="#FF3A3A40"/>
    <SolidColorBrush x:Key="ShanyuTextBrush" Color="#FFE0E0E8"/>
    <SolidColorBrush x:Key="ShanyuSubTextBrush" Color="#FF8A8A96"/>
    <SolidColorBrush x:Key="ShanyuHoverBrush" Color="#FF2F2F36"/>
    <SolidColorBrush x:Key="ShanyuSelectedBrush" Color="#FF3E5A8A"/>
    <SolidColorBrush x:Key="ShanyuInputBrush" Color="#FF1D1D22"/>

    <Style x:Key="ToolBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolBarRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="2" Padding="4,2">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="#FF3E5A8A"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuSubTextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ShanyuInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShanyuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ShanyuPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShanyuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ShanyuInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShanyuBorderBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource ShanyuTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
