<Window
    x:Class="ShanyuEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShanyuEditor"
    xmlns:controls="using:ShanyuEditor.Controls"
    xmlns:pages="using:ShanyuEditor.Pages"
    Title="Shanyu Engine Editor"
    Width="1600" Height="900"
    MinWidth="1200" MinHeight="700"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Controls/EngineViewport.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource ShanyuBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: 自定义标题栏 -->
            <RowDefinition Height="32"/>
            <!-- Row 1: 工具栏 -->
            <RowDefinition Height="40"/>
            <!-- Row 2: 主编辑区 -->
            <RowDefinition Height="*"/>
            <!-- Row 3: 底部控制台 -->
            <RowDefinition Height="200" MinHeight="100"/>
            <!-- Row 4: 状态栏 -->
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Col 0: 左侧面板 -->
            <ColumnDefinition Width="250" MinWidth="180"/>
            <!-- Col 1: 中间视口 -->
            <ColumnDefinition Width="*"/>
            <!-- Col 2: 右侧面板 -->
            <ColumnDefinition Width="300" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             Row 0: 自定义标题栏（拖拽区域 + 菜单栏 + 播放控制）
             ══════════════════════════════════════════════════════ -->
        <Grid x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="3"
              Background="{StaticResource ShanyuPanelBrush}"
              PointerPressed="OnTitleBarPointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 品牌标识 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Shanyu" FontWeight="SemiBold"
                           Foreground="{StaticResource ShanyuAccentBrush}"
                           FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text=" Engine" Foreground="{StaticResource ShanyuTextBrush}"
                           FontSize="13" VerticalAlignment="Center" Margin="1,0,0,0"/>
            </StackPanel>

            <!-- 菜单栏 -->
            <MenuBar Grid.Column="1" Background="Transparent"
                     VerticalAlignment="Center" Margin="24,0">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New Scene" Tag="File.New" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+N"/>
                    <MenuFlyoutItem Text="Open Scene..." Tag="File.Open" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+O"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Save" Tag="File.Save" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+S"/>
                    <MenuFlyoutItem Text="Save As..." Tag="File.SaveAs" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+Shift+S"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Exit" Tag="File.Exit" Click="MenuItem_Click"/>
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Text="Undo" Tag="Edit.Undo" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+Z"/>
                    <MenuFlyoutItem Text="Redo" Tag="Edit.Redo" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+Y"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Delete" Tag="Edit.Delete" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Del"/>
                    <MenuFlyoutItem Text="Select All" Tag="Edit.SelectAll" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+A"/>
                    <MenuFlyoutItem Text="Deselect All" Tag="Edit.DeselectAll" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Ctrl+D"/>
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Translate" Tag="View.Transform.Translate" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="W"/>
                    <MenuFlyoutItem Text="Rotate" Tag="View.Transform.Rotate" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="E"/>
                    <MenuFlyoutItem Text="Scale" Tag="View.Transform.Scale" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="R"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Toggle Grid" Tag="View.ToggleGrid" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="G"/>
                    <MenuFlyoutItem Text="Toggle Gizmos" Tag="View.ToggleGizmos" Click="MenuItem_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Perspective" Tag="View.Perspective" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Num 5"/>
                    <MenuFlyoutItem Text="Top" Tag="View.Top" Click="MenuItem_Click"
                                    KeyboardAcceleratorTextOverride="Num 7"/>
                    <MenuFlyoutItem Text="Front" Tag="View.Front" Click="MenuItem_Click"/>
                    <MenuFlyoutItem Text="Left" Tag="View.Left" Click="MenuItem_Click"/>
                </MenuBarItem>
                <MenuBarItem Title="Blender">
                    <MenuFlyoutItem Text="Launch Blender" Tag="Blender.Launch" Click="MenuItem_Click"/>
                    <MenuFlyoutItem Text="Import Scene..." Tag="Blender.Import" Click="MenuItem_Click"/>
                    <MenuFlyoutItem Text="Sync with Engine" Tag="Blender.Sync" Click="MenuItem_Click"/>
                </MenuBarItem>
                <MenuBarItem Title="Tools">
                    <MenuFlyoutItem Text="Generate LOD" Tag="Tools.LOD.Generate" Click="MenuItem_Click"/>
                    <MenuFlyoutItem Text="Bake Lightmaps" Tag="Tools.Bake.Lightmaps" Click="MenuItem_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Import from Unity..." Tag="Tools.Import.Unity" Click="MenuItem_Click"/>
                    <MenuFlyoutItem Text="Import from Unreal..." Tag="Tools.Import.Unreal" Click="MenuItem_Click"/>
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About Shanyu Engine" Tag="Help.About" Click="MenuItem_Click"/>
                </MenuBarItem>
            </MenuBar>

            <!-- 播放控制按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="PlayBtn" Content="&#x25B6;" Width="32" Height="24"
                        Click="PlayButton_Click" Background="Transparent"
                        BorderThickness="0" FontSize="12" ToolTipService.ToolTip="Play"/>
                <Button x:Name="PauseBtn" Content="&#x23F8;" Width="32" Height="24"
                        Click="PauseButton_Click" Background="Transparent"
                        BorderThickness="0" FontSize="12" ToolTipService.ToolTip="Pause"/>
                <Button x:Name="StopBtn" Content="&#x23F9;" Width="32" Height="24"
                        Click="StopButton_Click" Background="Transparent"
                        BorderThickness="0" FontSize="12" ToolTipService.ToolTip="Stop"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             Row 1: 工具栏
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3"
                Background="{StaticResource ShanyuPanelBrush}"
                BorderBrush="{StaticResource ShanyuBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <!-- Gizmo 切换 -->
                <RadioButton x:Name="GizmoTranslateBtn" Content="&#x2194;"
                             GroupName="GizmoMode" IsChecked="True"
                             Click="GizmoTranslate_Click"
                             Style="{StaticResource ToolBarRadioStyle}"
                             Width="32" Height="28"
                             ToolTipService.ToolTip="Translate (W)"/>
                <RadioButton x:Name="GizmoRotateBtn" Content="&#x21BB;"
                             GroupName="GizmoMode"
                             Click="GizmoRotate_Click"
                             Style="{StaticResource ToolBarRadioStyle}"
                             Width="32" Height="28"
                             ToolTipService.ToolTip="Rotate (E)"/>
                <RadioButton x:Name="GizmoScaleBtn" Content="&#x25A1;"
                             GroupName="GizmoMode"
                             Click="GizmoScale_Click"
                             Style="{StaticResource ToolBarRadioStyle}"
                             Width="32" Height="28"
                             ToolTipService.ToolTip="Scale (R)"/>

                <Border Width="1" Background="{StaticResource ShanyuBorderBrush}" Margin="8,2"/>

                <!-- 常用工具 -->
                <Button Content="&#x25A2;" Style="{StaticResource ToolBarButtonStyle}"
                        Width="32" Height="28" ToolTipService.ToolTip="Selection Tool (Q)"/>
                <Button Content="&#x2295;" Style="{StaticResource ToolBarButtonStyle}"
                        Width="32" Height="28" ToolTipService.ToolTip="Add Actor"/>
                <Button Content="&#x229E;" Style="{StaticResource ToolBarButtonStyle}"
                        Width="32" Height="28" ToolTipService.ToolTip="Focus Selection (F)"/>

                <Border Width="1" Background="{StaticResource ShanyuBorderBrush}" Margin="8,2"/>

                <!-- 渲染选项 -->
                <ToggleButton x:Name="GridToggle" Content="&#x229F;"
                              IsChecked="True" Style="{StaticResource ToolBarRadioStyle}"
                              Width="32" Height="28"
                              ToolTipService.ToolTip="Toggle Grid"
                              Click="OnGridToggle"/>
                <ToggleButton x:Name="WireframeToggle" Content="&#x25CB;"
                              Style="{StaticResource ToolBarRadioStyle}"
                              Width="32" Height="28"
                              ToolTipService.ToolTip="Wireframe Mode"
                              Click="OnWireframeToggle"/>

                <Border Width="1" Background="{StaticResource ShanyuBorderBrush}" Margin="8,2"/>

                <!-- 快捷操作 -->
                <Button Content="&#x2B1A;" Style="{StaticResource ToolBarButtonStyle}"
                        Width="32" Height="28" ToolTipService.ToolTip="Blender Import"
                        Tag="Blender.Import" Click="ToolbarButton_Click"/>
                <Button Content="&#x25C9;" Style="{StaticResource ToolBarButtonStyle}"
                        Width="32" Height="28" ToolTipService.ToolTip="Snap Settings"/>
                <Button Content="&#x2B53;" Style="{StaticResource ToolBarButtonStyle}"
                        Width="32" Height="28" ToolTipService.ToolTip="Lighting Settings"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             Row 2: 主编辑区（三列）
             ══════════════════════════════════════════════════════ -->

        <!-- 左侧面板：Outliner + ContentBrowser -->
        <Grid Grid.Row="2" Grid.Column="0"
              Background="{StaticResource ShanyuPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- 上半：Outliner -->
            <Border Grid.Row="0">
                <pages:OutlinerPage x:Name="OutlinerPage"/>
            </Border>

            <!-- 分割线 -->
            <GridSplitter Grid.Row="1" Height="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource ShanyuBorderBrush}"
                          Padding="0,1"/>

            <!-- 下半：Content Browser -->
            <Border Grid.Row="2">
                <pages:ContentBrowserPage x:Name="ContentBrowserPage"/>
            </Border>
        </Grid>

        <!-- 左侧分割线 -->
        <GridSplitter Grid.Row="2" Grid.Column="0"
                      Width="3" HorizontalAlignment="Right"
                      Background="{StaticResource ShanyuBorderBrush}"/>

        <!-- 中间：EngineViewport -->
        <Grid Grid.Row="2" Grid.Column="1" Background="#FF0A0A0E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 视口标签栏 -->
            <Border Grid.Row="0" Background="#FF151518" Height="24"
                    BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,2" Spacing="8">
                    <TextBlock Text="Viewport" Foreground="{StaticResource ShanyuSubTextBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ViewportModeCombo" MinWidth="110" SelectedIndex="0"
                              Background="Transparent" BorderThickness="0"
                              FontSize="11" Foreground="{StaticResource ShanyuTextBrush}"
                              SelectionChanged="OnViewportModeChanged">
                        <ComboBoxItem Content="Perspective"/>
                        <ComboBoxItem Content="Orthographic"/>
                        <ComboBoxItem Content="Top"/>
                        <ComboBoxItem Content="Front"/>
                        <ComboBoxItem Content="Left"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 引擎视口控件 -->
            <controls:EngineViewport Grid.Row="1" x:Name="Viewport"
                                    ActorClicked="OnViewportActorClicked"/>

            <!-- 视口底部状态 -->
            <Border Grid.Row="2" Background="#FF151518" Height="20">
                <StackPanel Orientation="Horizontal" Margin="8,2" Spacing="12">
                    <TextBlock x:Name="ViewportStatusText" Text="Ready"
                               Foreground="{StaticResource ShanyuSubTextBrush}" FontSize="10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右侧分割线 -->
        <GridSplitter Grid.Row="2" Grid.Column="1"
                      Width="3" HorizontalAlignment="Right"
                      Background="{StaticResource ShanyuBorderBrush}"/>

        <!-- 右侧面板：Inspector -->
        <Border Grid.Row="2" Grid.Column="2">
            <pages:InspectorPage x:Name="InspectorPage"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             Row 3: 底部控制台面板
             ══════════════════════════════════════════════════════ -->

        <!-- 控制台上部分割线 -->
        <GridSplitter Grid.Row="2" Grid.ColumnSpan="3"
                      Height="3" HorizontalAlignment="Stretch"
                      Background="{StaticResource ShanyuBorderBrush}"/>

        <Grid Grid.Row="3" Grid.ColumnSpan="3"
              Background="{StaticResource ShanyuPanelBrush}"
              BorderBrush="{StaticResource ShanyuBorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 控制台标签 -->
            <Border Grid.Row="0" Background="#FF1C1C20" Padding="8,2"
                    BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Console" FontWeight="SemiBold"
                           Foreground="{StaticResource ShanyuTextBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </Border>

            <!-- 控制台页面 -->
            <pages:ConsolePage Grid.Row="1" x:Name="ConsolePage"/>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             Row 4: 状态栏
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Grid.ColumnSpan="3"
                Background="#FF1C1C20"
                BorderBrush="{StaticResource ShanyuBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 当前工具 -->
                <TextBlock Grid.Column="0" x:Name="StatusTool"
                           Text="Translate" FontSize="10"
                           Foreground="{StaticResource ShanyuAccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- FPS -->
                <TextBlock Grid.Column="1" x:Name="StatusFPS"
                           Text="60 FPS" FontSize="10"
                           Foreground="#FF80FF80" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Draw Calls -->
                <TextBlock Grid.Column="2" x:Name="StatusDrawCalls"
                           Text="Draw: 0" FontSize="10"
                           Foreground="{StaticResource ShanyuSubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- GPU Memory -->
                <TextBlock Grid.Column="3" x:Name="StatusGPU"
                           Text="GPU: 0 MB" FontSize="10"
                           Foreground="{StaticResource ShanyuSubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- 选中数量（右侧） -->
                <TextBlock Grid.Column="5" x:Name="StatusSelection"
                           Text="Selected: 0" FontSize="10"
                           Foreground="{StaticResource ShanyuSubTextBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
