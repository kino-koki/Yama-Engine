<Page
    x:Class="ShanyuEditor.Pages.InspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShanyuEditor.Pages">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource ShanyuPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Panel Header -->
        <Border Grid.Row="0" Background="#FF1C1C20" Padding="8,4"
                BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Inspector" Style="{StaticResource PanelHeaderStyle}"/>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4">
            <StackPanel x:Name="RootPanel" Spacing="2">

                <!-- ═══ No Selection: Scene Properties ═══ -->
                <StackPanel x:Name="ScenePropertiesPanel" Visibility="Collapsed" Spacing="2">
                    <TextBlock Text="Scene Properties" FontWeight="SemiBold" Foreground="{StaticResource ShanyuAccentBrush}" FontSize="13" Margin="4,4,4,2"/>
                    <Border Background="{StaticResource ShanyuPanelBrush}" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ShanyuCornerRadius}" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Environment" Foreground="{StaticResource ShanyuSubTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ambient Color" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Row="0" Grid.Column="1" Height="24" Background="#FF1D1D22" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2">
                                    <Rectangle x:Name="SceneAmbientColor" Fill="#FF404050"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ambient Intensity" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="SceneAmbientIntensity" Value="0.3" Minimum="0" Maximum="5" SmallChange="0.1" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sky Color" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Row="2" Grid.Column="1" Height="24" Background="#FF1D1D22" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2">
                                    <Rectangle x:Name="SceneSkyColor" Fill="#FF6495ED"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Fog" Foreground="{StaticResource ShanyuSubTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Enabled" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="FogEnabled" IsChecked="False"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Density" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="FogDensity" Value="0.01" Minimum="0" Maximum="1" SmallChange="0.001" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Start" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="FogStart" Value="100" Minimum="0" SmallChange="10" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="End" Foreground="{StaticResource ShanyuTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <NumberBox Grid.Row="3" Grid.Column="1" x:Name="FogEnd" Value="1000" Minimum="0" SmallChange="50" SpinButtonPlacementMode="Inline"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ Object Inspector (visible when selection exists) ═══ -->
                <StackPanel x:Name="ObjectInspectorPanel" Visibility="Visible" Spacing="2">

                    <!-- Name & Type Header -->
                    <Border Background="#FF1C1C20" Padding="8,6" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="ActorNameBox" Text="Actor" FontSize="14" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ShanyuTextBrush}" TextChanged="OnObjectNameChanged"/>
                            <Border Grid.Column="1" Background="#FF3E5A8A" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="ActorTypeLabel" Text="Actor" FontSize="11" Foreground="#FFE0E0E8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Transform Section -->
                    <Expander Header="Transform" IsExpanded="True" Background="#FF1C1C20" Foreground="{StaticResource ShanyuTextBrush}">
                        <StackPanel Padding="8,4" Spacing="6">
                            <!-- Position -->
                            <TextBlock Text="Position" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="X" Foreground="#FFFF6666" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="1" x:Name="PosX" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                                <TextBlock Grid.Column="2" Text="Y" Foreground="#FF66FF66" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="3" x:Name="PosY" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                                <TextBlock Grid.Column="4" Text="Z" Foreground="#FF6666FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="5" x:Name="PosZ" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                            </Grid>

                            <!-- Rotation -->
                            <TextBlock Text="Rotation (Degrees)" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="X" Foreground="#FFFF6666" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="1" x:Name="RotX" Value="0" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                                <TextBlock Grid.Column="2" Text="Y" Foreground="#FF66FF66" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="3" x:Name="RotY" Value="0" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                                <TextBlock Grid.Column="4" Text="Z" Foreground="#FF6666FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="5" x:Name="RotZ" Value="0" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                            </Grid>

                            <!-- Scale -->
                            <TextBlock Text="Scale" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="X" Foreground="#FFFF6666" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="1" x:Name="ScaleX" Value="1" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                                <TextBlock Grid.Column="2" Text="Y" Foreground="#FF66FF66" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="3" x:Name="ScaleY" Value="1" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                                <TextBlock Grid.Column="4" Text="Z" Foreground="#FF6666FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <NumberBox Grid.Column="5" x:Name="ScaleZ" Value="1" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="Transform_ValueChanged"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Rendering -->
                    <Expander Header="Rendering" Background="#FF1C1C20" Foreground="{StaticResource ShanyuTextBrush}">
                        <StackPanel Padding="8,4" Spacing="6">
                            <CheckBox x:Name="CastShadow" Content="Cast Shadow" IsChecked="True" FontSize="12"/>
                            <CheckBox x:Name="ReceiveShadow" Content="Receive Shadow" IsChecked="True" FontSize="12"/>
                            <CheckBox x:Name="IsStatic" Content="Static" IsChecked="False" FontSize="12"/>
                        </StackPanel>
                    </Expander>

                    <!-- Material -->
                    <Expander Header="Material" Background="#FF1C1C20" Foreground="{StaticResource ShanyuTextBrush}">
                        <StackPanel Padding="8,4" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="32" Height="32" Background="#FF4A90E2" CornerRadius="2"/>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Base Color" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}"/>
                                    <TextBox x:Name="BaseColorHex" Text="#FFFFFF" FontSize="11" Width="80"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Metallic" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}"/>
                                    <Slider x:Name="MetallicSlider" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Roughness" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}"/>
                                    <Slider x:Name="RoughnessSlider" Minimum="0" Maximum="1" Value="0.5" StepFrequency="0.01" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Texture" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="TextureAssetPathBox" Text="" FontSize="11" IsReadOnly="True" Grid.Column="0"/>
                                    <Button x:Name="SelectTextureButton" Content="..." Click="OnSelectTextureClick" FontSize="11" Grid.Column="1" Margin="4,0,0,0" Padding="8,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Tags & Layers -->
                    <Expander Header="Tags &amp; Layers" Background="#FF1C1C20" Foreground="{StaticResource ShanyuTextBrush}">
                        <StackPanel Padding="8,4" Spacing="6">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Layer" FontSize="10" Foreground="{StaticResource ShanyuSubTextBrush}"/>
                                <ComboBox x:Name="LayerCombo" SelectedIndex="0" FontSize="11">
                                    <ComboBoxItem Content="Default (0)"/>
                                    <ComboBoxItem Content="Player (1)"/>
                                    <ComboBoxItem Content="Enemy (2)"/>
                                    <ComboBoxItem Content="Environment (3)"/>
                                    <ComboBoxItem Content="UI (4)"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Component List -->
                    <ItemsControl x:Name="ComponentList" Margin="0,2"/>
                    
                    <!-- Add Component Button -->
                    <Border Padding="8" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,1,0,0">
                        <Button x:Name="AddComponentButton" Content="+ Add Component" HorizontalAlignment="Stretch" Background="#FF3A3A40" Click="OnAddComponentClick">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Mesh Component" Tag="Mesh" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Light Component" Tag="Light" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Camera Component" Tag="Camera" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Script Component" Tag="Script" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Animator Component" Tag="Animator" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Rigidbody Component" Tag="Rigidbody" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Audio Source" Tag="AudioSource" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Collider Component" Tag="Collider" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Particle System" Tag="ParticleSystem" Click="AddComponentItem_Click"/>
                                    <MenuFlyoutItem Text="Tag Component" Tag="Tag" Click="AddComponentItem_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Border>

                    <!-- Component Actions -->
                    <Border Background="{StaticResource ShanyuPanelBrush}" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ShanyuCornerRadius}" Margin="4,2" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="RemoveComponentBtn" Content="Remove" Click="RemoveComponent_Click" Background="#FF5A2D2D" BorderThickness="0" Padding="12,4" FontSize="11"/>
                            <Button x:Name="CopyComponentBtn" Content="Copy" Click="CopyComponent_Click" Padding="12,4" FontSize="11"/>
                            <Button x:Name="ResetComponentBtn" Content="Reset" Click="ResetComponent_Click" Padding="12,4" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Multi-selection hint -->
                    <TextBlock x:Name="MultiSelectHint" Text="Multiple objects selected - showing common properties" Visibility="Collapsed" Foreground="{StaticResource ShanyuSubTextBrush}" FontSize="11" Margin="4,2" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
