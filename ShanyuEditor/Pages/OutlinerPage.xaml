<Page
    x:Class="ShanyuEditor.Pages.OutlinerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShanyuEditor.Pages">

    <Grid Background="{StaticResource ShanyuPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 面板标题栏 -->
        <Border Grid.Row="0" Background="#FF1C1C20" Padding="8,4"
                BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Outliner" Style="{StaticResource PanelHeaderStyle}"/>
        </Border>

        <!-- 搜索框 -->
        <Border Grid.Row="1" Padding="4" BorderBrush="{StaticResource ShanyuBorderBrush}" BorderThickness="0,0,0,1">
            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="Search actors..."
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged"
                            FontSize="12"
                            Background="{StaticResource ShanyuInputBrush}"/>
        </Border>

        <!-- 层级树 -->
        <TreeView x:Name="HierarchyTree"
                   Grid.Row="2"
                   CanDragItems="True"
                   CanReorderItems="True"
                   AllowDrop="True"
                   SelectionMode="Extended"
                   DoubleTapped="OnTreeDoubleTapped"
                   DragItemsStarting="OnTreeDragStarting"
                   DragItemsCompleted="OnTreeDragCompleted">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:ActorViewModel">
                    <TreeViewItem ExpanderStyle="{StaticResource ShanyuTreeExpanderStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Padding="2,2">
                            <!-- 可见性切换 -->
                            <FontIcon x:Name="VisibilityIcon"
                                      Glyph="&#xE7B3;"
                                      FontSize="12"
                                      Foreground="{StaticResource ShanyuTextBrush}"
                                      Tapped="OnVisibilityTapped"/>
                            <!-- 类型图标 -->
                            <FontIcon Glyph="&#xE7C3;"
                                      FontSize="12"
                                      Foreground="{StaticResource ShanyuSubTextBrush}"/>
                            <!-- Actor 名称 -->
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="12"
                                       Foreground="{StaticResource ShanyuTextBrush}"/>
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>

            <TreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Rename" Icon="Rename" Click="OnContextRename"/>
                    <MenuFlyoutItem Text="Duplicate" Icon="Copy" Click="OnContextDuplicate"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Set Parent" Click="OnContextSetParent"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Delete" Icon="Delete" Click="OnContextDelete"/>
                </MenuFlyout>
            </TreeView.ContextFlyout>
        </TreeView>
    </Grid>
</Page>
