# ── 构建输出 ──
bin/
obj/
out/
build/
# 例外：YamaEngine/Build 是引擎“构建/打包子系统”的源码目录，必须纳入版本控制。
# 若被上面的通用 build/ 规则忽略，CI 全新检出后该目录缺失，
# 会导致 YamaEngine.Build 命名空间不存在（CS0234，EngineDiagnostics/RuntimeSceneLoader/EngineBootstrap 等编译失败）。
!YamaEngine/Build/
artifacts/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo
*.pdb
*.dll.config
*.exe.config

# ── IDE ──
.vs/
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
Thumbs.db
.DS_Store
desktop.ini

# ── NuGet ──
*.nupkg
*.snupkg
.nuget/
# 仅忽略仓库根 packages/（NuGet 缓存），不误伤 YamaEngine/Packages/ 源码
/packages/

# ── 运行时产物 ──
Builds/
*.yama.bak
*.log

# ── 测试结果 ──
TestResults/

# ── 可再生日录（不入库）──
third_party/
third_party/vcpkg/
# DXC 着色器编译器 (随引擎分发的二进制, HLSL 运行时编译必需 — 例外保留)
!third_party/dxc/
dotnet-sdk-cache/
.dotnet-temp/
.uploads/

# ── 临时文件 ──
*.tmp
*.temp
*.cache
*.bak

# ── 评估报告 HTML 产物 (开发期间不入库) ──
yama-engine-evaluation/

# ── Rust target ──
YamaEngine.Rust/target/

# ── C++ 构建中间文件 ──
YamaEngineBridge/x64/
YamaEngineBridge/Debug/
YamaEngineBridge/Release/
YamaEngine.Native/build/

# ── Python 缓存 (DCC 插件) ──
__pycache__/
*.pyc
.venv/

# ── 用户配置 (本地覆盖) ──
editor_layout.json
editor_settings.json

# ── 历史工作文件与缓存 ──
_dup_backup/
dotnet-sdk-cache/
*.log
all_errors.txt
build_errors.txt
build_log.txt
build_out.txt
cur_build.txt
d3d12_errors.txt
dotnet_install.log
dup_err.txt
dup_out.txt
dup_report.txt
eval_build_engine.txt
py_test.txt
test_write.txt

# ── 会话分析/修复临时产物（仓库根，_ 前缀）──
/_*.py
/_*.txt
/_*.csv
/_*.json
/_*.md
/_repair/

# ── 根目录历史分析脚本与构建日志（一次性清理后保持忽略）──
/analyze*.py
/fix_*.py
/perfile.py
/engine_build.txt
/eval_build*.txt
/eval_restore*.txt
/phys_run.log
/ai_npc.json
/friction_dbg.txt
/test_out.txt
/b*.txt
/t*.txt
/nd*.txt
/nb*.txt
/tb*.txt
/ab*.txt
/rb*.txt
/sd.txt
/kd.txt
/tbc.txt
/test_full.txt

# ── 构建/探测临时产物（根目录，不入库）──
/build.log
/build_out.log
/build_log.txt
/probe_log.txt
/_probe*.txt
/NuGet.fix.config
/.gen
/.screenshots
/project_memory.md
.env
