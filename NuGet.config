<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 源配置 - 加速 dotnet restore
  原 aliyun(404) 与 azure-cn(代理 502) 两个镜像源当前不可用, 已从列表中移除,
  避免 restore 阶段因坏源失败/刷屏拖慢构建。保留国内可用镜像 + 官方兜底。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="huaweicloud" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
    <add key="tencent" value="https://mirrors.cloud.tencent.com/nuget/" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceTimeout>
    <add key="huaweicloud" value="30" />
    <add key="tencent" value="30" />
    <add key="nuget.org" value="30" />
  </packageSourceTimeout>
</configuration>
