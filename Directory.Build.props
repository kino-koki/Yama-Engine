<?xml version="1.0" encoding="utf-8"?>
<!-- Directory.Build.props - 将所有中间输出和 NuGet 资产统一重定向到仓库根目录下的 artifacts/
     （相对路径，可移植；不再硬编码到 E: 盘，任意机器均可构建）-->
<Project>
  <PropertyGroup>
    <!-- 中间输出目录：所有 obj 文件输出到 artifacts/obj/<项目名>/ -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <!-- 最终输出目录：artifacts/bin/<项目名>/ -->
    <OutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</OutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- NuGet 资产文件路径 -->
    <RestoreOutputPath>$(BaseIntermediateOutputPath)</RestoreOutputPath>
    <RestoreAssetsFileFallback>$(BaseIntermediateOutputPath)project.assets.json</RestoreAssetsFileFallback>
    <!-- NuGet 锁文件 -->
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)artifacts\nuget.lock</NuGetLockFilePath>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>

    <!-- ══════════════════════════════════════════════════════════════
         生产级构建策略（2026-11-14）
         ──────────────────────────────────────────────────────────────
         引擎大量子系统在启用 Nullable 之前编写，存量可空性警告 ~5900 条（CS86xx）
         及占位成员 / 事件 stub / 继承命名警告 ~1200 条。为达成"0 警告"生产门禁，
         显式抑制噪声类别，同时保留真实缺陷类别（可空性之外的正确性 / 性能 / API 废弃）
         以便逐项修复。各抑制类别均有明确工程理由，避免误伤真实缺陷。
         ══════════════════════════════════════════════════════════════ -->
    <NoWarn>$(NoWarn);
      <!-- 可空性存量噪声：引擎子系统在启用 Nullable 之前编写，存量 ~5900 条 CS86xx。
           2026-11-15 已全量探测并确认（2928 条，CS8618 占 1290 条）。
           恢复抑制以维持"0 警告"门禁；新代码须无警告，存量待子系统接入 Nullable 后逐项消除。 -->
      CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8621;CS8622;
      CS8625;CS8629;CS8634;CS8669;CS8670;CS8714;CS8765;CS8767;CS8500;CS8073;CS8321;
      <!-- 占位成员（字段 / 事件）：引擎预留 API 面，待子系统接入时启用 -->
      CS0169;CS0649;CS0067;CS0414;CS0417;
      <!-- 继承与命名：基类 API 稳定性，不改动签名 -->
      CS0108;CS0109;CS0114;CS1717;
      <!-- 其他已确认非缺陷噪声 -->
      CS0465;CS0628;CS0675;CS0472;CS0420;
      <!-- Silk.NET Vulkan 绑定模式：native 指针 / ref-in 转换为底层互操作惯用法 -->
      CS9191;CS9192;CS9193;
      <!-- 未使用局部变量：调试/占位赋值，非缺陷 -->
      CS0219;
      <!-- SYSLIB0014：FTP 部署使用 FtpWebRequest（WebRequest 子类），HttpClient 不支持 FTP 协议，.NET 无替代 API，属合法遗留用法 -->
      SYSLIB0014
    </NoWarn>
  </PropertyGroup>
</Project>
