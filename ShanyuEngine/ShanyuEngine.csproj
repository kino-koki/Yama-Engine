<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ShanyuEngine</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>false</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <RestoreEnabled>true</RestoreEnabled>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 输出路径统一由 Directory.Build.props 重定向到 artifacts/，此处不再重复覆盖，
         避免硬编码 E: 盘导致不可移植，并消除 MSB3539 警告 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ====== Vulkan 1.4 后端 (Silk.NET) ====== -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Core" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />

    <!-- ====== 数学与工具库 ====== -->
    <PackageReference Include="Vortice.Mathematics" Version="1.9.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />

    <!-- ====== 脚本编译 (Roslyn) ====== -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="4.9.2" />

    <!-- ====== UI 调试 ====== -->
    <PackageReference Include="ImGui.NET" Version="1.90.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ====== 全局 Using：补齐框架命名空间，消除一批 CS0246（属性/集合类型缺失） ====== -->
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Text.Json.Serialization" />
    <Using Include="System.Runtime.InteropServices" />
    <Using Include="System.Collections.Concurrent" />
    <Using Include="Microsoft.Win32.SafeHandles" />
    <Using Include="ShanyuEngine.DataSystem" />
    <!-- 2026-08-07 构建修复：补齐常用系统命名空间（Vector3/泛型/线程/LINQ 等漏 using） -->
    <Using Include="System.Numerics" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.IO" />
    <Using Include="System.Diagnostics" />

    <!-- ====== RHI 抽象层 ====== -->
    <Compile Include="RHI\**\*.cs" />
    <!-- D3D12 后端已废弃，排除所有 D3D12 实现文件 -->
    <!-- 注意：实际 D3D12 实现文件位于 RHI\ 根（D3D12*Real.cs），而非 RHI\D3D12\ 子目录，
         因此需同时用两个 Remove 才能覆盖；这些文件依赖未引用的 Vortice.Direct3D12 包。 -->
    <Compile Remove="RHI\D3D12\**\*.cs" />
    <Compile Remove="RHI\D3D12*Real.cs" />

    <!-- ====== Vulkan 后端（唯一图形后端） ====== -->
    <Compile Include="Vulkan\**\*.cs" />

    <!-- ====== 引擎子系统 ====== -->
    <Compile Include="Rendering\**\*.cs" />
    <Compile Include="MicroCluster\**\*.cs" />
    <Compile Include="Particles\**\*.cs" />
    <Compile Include="Editor\**\*.cs" />
    <Compile Include="Materials\**\*.cs" />
    <Compile Include="ShaderGraph\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
    <Compile Include="AI\**\*.cs" />
    <Compile Include="Core\**\*.cs" />
    <Compile Include="ECS\**\*.cs" />
    <Compile Include="Projects\**\*.cs" />
    <Compile Include="Assets\**\*.cs" />
    <Compile Include="Scenes\**\*.cs" />
    <Compile Include="Prefabs\**\*.cs" />
    <Compile Include="Modeling\**\*.cs" />
    <Compile Include="Animation\**\*.cs" />
    <Compile Include="Physics\**\*.cs" />
    <Compile Include="Skinning\**\*.cs" />
    <Compile Include="Scripting\**\*.cs" />
    <Compile Include="Runtime\**\*.cs" />
    <Compile Include="Gameplay\**\*.cs" />
    <Compile Include="Character\**\*.cs" />
    <Compile Include="Input\**\*.cs" />
    <Compile Include="Config\**\*.cs" />
    <Compile Include="World\**\*.cs" />
    <Compile Include="Audio\**\*.cs" />
    <Compile Include="Networking\**\*.cs" />
    <Compile Include="CodeEditing\**\*.cs" />
    <Compile Include="DCC\**\*.cs" />
    <Compile Include="Build\**\*.cs" />
    <Compile Include="Diagnostics\**\*.cs" />
    <Compile Include="GameFramework\**\*.cs" />
    <Compile Include="DataSystem\**\*.cs" />
    <Compile Include="Localization\**\*.cs" />
    <Compile Include="Shaders\**\*.cs" />
    <Compile Include="VFX\**\*.cs" />
    <Compile Include="Network\**\*.cs" />
    <Compile Include="Sequencer\**\*.cs" />
    <Compile Include="VisualScript\**\*.cs" />
    <Compile Include="PluginSystem\**\*.cs" />
    <Compile Include="Platform\**\*.cs" />
    <Compile Include="Processing\**\*.cs" />
    <Compile Include="Memory\**\*.cs" />
    <Compile Include="Testing\**\*.cs" />
    <Compile Include="Platforms\**\*.cs" />
    <Compile Include="Packages\**\*.cs" />

    <!-- 根目录入口 -->
    <Compile Include="EngineApplication.cs" />
    <!-- 兼容类型补全层（缺失的基础类型：Camera / BodyDescriptor / PhysicsRenderTarget 等） -->
    <Compile Include="EngineCompatTypes.cs" />

    <!-- ====== 排除重复或已废弃文件 ====== -->
    <!-- SparseShadowAtlases: 开发中，暂不编译 -->
    <Compile Remove="Rendering\**\*SparseShadowAtlases*.cs" />
    <!-- VisualScriptingSystem.cs 与 NodeScriptSystem.cs 类型重复 -->
    <Compile Remove="Scripting\VisualScriptingSystem.cs" />
    <!-- BuildPipeline.cs 是 BuildPipelineReal.cs 的早期简版，已被取代 -->
    <Compile Remove="Build\BuildPipeline.cs" />

    <!-- ====== 2026-08-07 构建修复: 隔离外围损坏文件 ====== -->
    <!-- 以下文件为 DCC Python 代码生成器 / 脚本热重载工具，属外围功能，
         其内部以 C# 普通字符串字面量内嵌多行 Python 导致大量 CS1010/CS1009 错误，
         且均未被引擎核心作为类型引用。先隔离以获得可运行核心，后续专项修复。 -->
    <Compile Remove="DCC\BlenderPythonPlugin.cs" />
    <Compile Remove="DCC\MayaPythonPlugin.cs" />
    <Compile Remove="Scripting\ScriptHotReload.cs" />

    <!-- 排除不存在的资源文件，避免 MSB3552 -->
    <EmbeddedResource Remove="**\*.resx" />

    <!-- ====== 已修复并重新纳入构建（2026-08-06） ====== -->
    <!-- NetworkLobbySystem.cs: 已从26775行重写为909行干净实现 -->
    <!-- ScriptEngine.cs: 已从3807行重写为980行干净Roslyn脚本引擎 -->

    <!-- ====== 以下文件已修复并重新纳入构建（2026-08-02） ====== -->
    <!-- LinuxAdapter.cs: 第 182 行 _ keycode 空格错误已修复 -->
    <!-- WidgetAnimation.cs: 8 行截断文件已重写为完整 Widget 动画系统 -->
    <!-- ContactManifold 冲突已解决: NarrowphaseSystem.cs 的 struct 改名为 NarrowphaseContactManifold -->
    <!-- AnimationClip 冲突已解决: AnimationCore.cs 的 class 改名为 AnimationClipCore -->
    <!-- CollisionDetectionReal.cs: 提供 PhysicsVector3/AABBShape 等基础类型，解决 BroadphaseReal.cs 依赖断裂 -->
    <!-- 其余 18 个文件经审查确认为合法现代 C# 代码，非损坏 -->
  </ItemGroup>
</Project>
