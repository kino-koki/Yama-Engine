<Application
    x:Class="YamaEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YamaEditor">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="YamaAccentBrush" Color="#FF4A90E2"/>
            <SolidColorBrush x:Key="YamaBackgroundBrush" Color="#FF1A1A1E"/>
            <SolidColorBrush x:Key="YamaPanelBrush" Color="#FF25252A"/>
            <SolidColorBrush x:Key="YamaBorderBrush" Color="#FF3A3A40"/>
            <SolidColorBrush x:Key="YamaTextBrush" Color="#FFE0E0E8"/>
            <SolidColorBrush x:Key="YamaSubTextBrush" Color="#FF8A8A96"/>
            <Thickness x:Key="PanelPadding">4</Thickness>
            <CornerRadius x:Key="YamaCornerRadius">2</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
