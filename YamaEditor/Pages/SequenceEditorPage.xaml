<Page
    x:Class="YamaEditor.Pages.SequenceEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YamaEditor.Pages">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource YamaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource YamaPanelBrush}" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PlayBtn" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Click="Play_Click" Width="36" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Play"/>
                    <Button x:Name="PauseBtn" Content="&#xE769;" FontFamily="Segoe MDL2 Assets" Click="Pause_Click" Width="36" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pause"/>
                    <Button x:Name="StopBtn" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" Click="Stop_Click" Width="36" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Stop"/>
                    <Button x:Name="PrevFrameBtn" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Click="PrevFrame_Click" Width="36" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Previous Frame"/>
                    <Button x:Name="NextFrameBtn" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Click="NextFrame_Click" Width="36" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Next Frame"/>
                </StackPanel>
                <Border Width="1" Background="{StaticResource YamaBorderBrush}" Margin="4,4"/>
                <!-- Timecode Display -->
                <Border Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="4,0">
                    <TextBlock x:Name="TimecodeDisplay" Text="00:00:00:00" Foreground="#FF4A90E2" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                </Border>
                <!-- Frame counter -->
                <TextBlock Grid.Column="3" Text="Frame:" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <NumberBox Grid.Column="4" x:Name="FrameNumberBox" Value="0" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Inline" Width="100" ValueChanged="FrameNumber_ValueChanged"/>
                <!-- Add Track -->
                <Button Grid.Column="6" Content="+ Add Track" Click="AddTrack_Click" Padding="10,4" FontSize="11" Margin="4,0"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Track Names -->
            <Border Grid.Column="0" Background="{StaticResource YamaPanelBrush}" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FF1C1C20" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Tracks" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" Margin="8,2" FontWeight="SemiBold"/>
                </Border>
                <ListView Grid.Row="1" x:Name="TrackListView"
                          Background="Transparent"
                          SelectionMode="Extended"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="32" Padding="4">
                                <!-- Track icon -->
                                <FontIcon Grid.Column="0" Glyph="&#xE9E2;" FontSize="12" Foreground="#FF4A90E2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <!-- Track name -->
                                <TextBlock Grid.Column="1" Text="{Binding TrackName}" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <!-- Visibility toggle -->
                                <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay}" MinWidth="0" Padding="0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Divider -->
            <GridSplitter Grid.Column="1" Width="3" Background="{StaticResource YamaBorderBrush}"/>

            <!-- Timeline Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Time Ruler -->
                <Border Grid.Row="0" Background="#FF1C1C20" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer x:Name="RulerScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="TimeRulerCanvas" Height="24">
                            <!-- Time ruler tick marks will be drawn in code-behind -->
                        </Canvas>
                    </ScrollViewer>
                </Border>

                <!-- Tracks with Timeline -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              x:Name="TimelineScrollViewer">
                    <Canvas x:Name="TimelineCanvas" Background="#FF0A0A0E">
                        <!-- Track rows and keyframes will be drawn in code-behind -->
                    </Canvas>
                </ScrollViewer>

                <!-- Playhead indicator (overlay) -->
                <Canvas Grid.RowSpan="2" x:Name="PlayheadCanvas" IsHitTestVisible="False">
                    <Line x:Name="PlayheadLine" X1="100" Y1="0" X2="100" Y2="1000" Stroke="#FFFF4444" StrokeThickness="1.5"/>
                    <Polygon x:Name="PlayheadHead" Points="94,0 106,0 100,8" Fill="#FFFF4444"/>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</Page>
