<Page
    x:Class="YamaEditor.Pages.MaterialEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YamaEditor.Pages">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource YamaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource YamaPanelBrush}" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Click="Save_Click" MinWidth="64" Padding="10,4" FontSize="12"/>
                <Button Content="Apply" Click="Apply_Click" MinWidth="64" Padding="10,4" FontSize="12"/>
                <Button Content="Preview" Click="Preview_Click" MinWidth="64" Padding="10,4" FontSize="12"/>
                <Button Content="Reset" Click="Reset_Click" MinWidth="64" Padding="10,4" FontSize="12"/>
                <Border Width="1" Background="{StaticResource YamaBorderBrush}" Margin="4,2"/>
                <TextBlock Text="Material Editor" Foreground="{StaticResource YamaSubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content: 3-Column Layout -->
        <Grid Grid.Row="1" ColumnDefinitions="260,*,260">

            <!-- Left: Properties Panel -->
            <Border Grid.Column="0" Background="{StaticResource YamaPanelBrush}" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Material Properties" FontWeight="SemiBold" Foreground="{StaticResource YamaAccentBrush}" FontSize="13"/>

                        <!-- Shader Model -->
                        <TextBlock Text="Shader Model" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ShaderModelCombo" SelectedIndex="0" Margin="0,2">
                            <ComboBoxItem Content="Unlit"/>
                            <ComboBoxItem Content="Lit (PBR)"/>
                            <ComboBoxItem Content="Subsurface"/>
                            <ComboBoxItem Content="Clear Coat"/>
                            <ComboBoxItem Content="Cloth"/>
                            <ComboBoxItem Content="Eye"/>
                            <ComboBoxItem Content="Hair"/>
                            <ComboBoxItem Content="Toon"/>
                        </ComboBox>

                        <!-- Blend Mode -->
                        <TextBlock Text="Blend Mode" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <ComboBox x:Name="BlendModeCombo" SelectedIndex="0" Margin="0,2">
                            <ComboBoxItem Content="Opaque"/>
                            <ComboBoxItem Content="Translucent"/>
                            <ComboBoxItem Content="Masked"/>
                            <ComboBoxItem Content="Additive"/>
                            <ComboBoxItem Content="Modulate"/>
                        </ComboBox>

                        <!-- Shading -->
                        <TextBlock Text="Shading" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <ComboBox x:Name="ShadingCombo" SelectedIndex="0" Margin="0,2">
                            <ComboBoxItem Content="Default Lit"/>
                            <ComboBoxItem Content="Subsurface"/>
                            <ComboBoxItem Content="Unlit"/>
                            <ComboBoxItem Content="From Material Expression"/>
                        </ComboBox>

                        <!-- Two Sided -->
                        <CheckBox x:Name="TwoSidedCheck" Content="Two Sided" Margin="0,4,0,0" IsChecked="False"/>

                        <Border Height="1" Background="{StaticResource YamaBorderBrush}" Margin="0,8"/>

                        <!-- PBR Parameters -->
                        <TextBlock Text="PBR Parameters" FontWeight="SemiBold" Foreground="{StaticResource YamaAccentBrush}" FontSize="13"/>

                        <!-- Base Color -->
                        <TextBlock Text="Base Color" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <Border Height="28" Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2">
                                <Rectangle x:Name="BaseColorPreview" Fill="#FFB0B0B0"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Width="28" Margin="4,0,0,0" Click="BrowseTexture_Click" Tag="BaseColor"/>
                        </Grid>

                        <!-- Metallic -->
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Metallic" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="MetallicValue" Value="0" Minimum="0" Maximum="1" SmallChange="0.01" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <Border Height="28" Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2">
                                <TextBlock x:Name="MetallicTex" Text="None" Foreground="{StaticResource YamaSubTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Width="28" Margin="4,0,0,0" Click="BrowseTexture_Click" Tag="Metallic"/>
                        </Grid>

                        <!-- Roughness -->
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Roughness" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="RoughnessValue" Value="0.5" Minimum="0" Maximum="1" SmallChange="0.01" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <Border Height="28" Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2">
                                <TextBlock x:Name="RoughnessTex" Text="None" Foreground="{StaticResource YamaSubTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Width="28" Margin="4,0,0,0" Click="BrowseTexture_Click" Tag="Roughness"/>
                        </Grid>

                        <!-- Normal Map -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Normal Map" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <Border Height="28" Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2">
                                <TextBlock x:Name="NormalTex" Text="None" Foreground="{StaticResource YamaSubTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Width="28" Margin="4,0,0,0" Click="BrowseTexture_Click" Tag="Normal"/>
                        </Grid>

                        <!-- Emissive -->
                        <TextBlock Text="Emissive" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <Border Height="28" Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="2">
                                <Rectangle x:Name="EmissiveColorPreview" Fill="#FF000000"/>
                            </Border>
                            <NumberBox Grid.Column="1" x:Name="EmissiveIntensity" Value="0" Minimum="0" Maximum="100" SmallChange="0.1" Width="80" Margin="4,0,0,0" SpinButtonPlacementMode="Inline"/>
                        </Grid>

                        <!-- Opacity -->
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Opacity" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="OpacityValue" Value="1" Minimum="0" Maximum="1" SmallChange="0.01" SpinButtonPlacementMode="Inline"/>
                        </Grid>

                        <!-- AO -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Ambient Occlusion" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <Border Height="28" Background="#FF1D1D22" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" CornerRadius="2">
                                <TextBlock x:Name="AOTex" Text="None" Foreground="{StaticResource YamaSubTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="4,0"/>
                            </Border>
                            <Button Grid.Column="1" Content="..." Width="28" Margin="4,0,0,0" Click="BrowseTexture_Click" Tag="AO"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center: Node Graph Preview (Static Visualization) -->
            <Grid Grid.Column="1" Background="#FF151518">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF1C1C20" Height="24" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Node Graph" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" Margin="8,2"/>
                </Border>

                <Canvas Grid.Row="1" x:Name="NodeGraphCanvas" Background="#FF0A0A0E">
                    <Canvas.Resources>
                        <Style x:Key="NodeStyle" TargetType="Border">
                            <Setter Property="Background" Value="#FF25252A"/>
                            <Setter Property="BorderBrush" Value="#FF3A3A40"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Width" Value="180"/>
                        </Style>
                    </Canvas.Resources>

                    <!-- Example Nodes (static preview) -->
                    <!-- Base Color Node -->
                    <Border Style="{StaticResource NodeStyle}" Canvas.Left="40" Canvas.Top="40" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Base Color" FontWeight="SemiBold" Foreground="#FFE0E0E8" FontSize="11"/>
                            <Border Height="1" Background="#FF3A3A40"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FF4A90E2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Color Output" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Border Height="28" Background="#FF1D1D22" BorderThickness="1" BorderBrush="#FF3A3A40" CornerRadius="2" Margin="0,4,0,0">
                                <Rectangle Fill="#FFB0B0B0"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Metallic-Roughness Node -->
                    <Border Style="{StaticResource NodeStyle}" Canvas.Left="40" Canvas.Top="240" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Metallic-Roughness" FontWeight="SemiBold" Foreground="#FFE0E0E8" FontSize="11"/>
                            <Border Height="1" Background="#FF3A3A40"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FF4A90E2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Metallic" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FF66CC66" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Roughness" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Normal Map Node -->
                    <Border Style="{StaticResource NodeStyle}" Canvas.Left="40" Canvas.Top="420" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Normal Map" FontWeight="SemiBold" Foreground="#FFE0E0E8" FontSize="11"/>
                            <Border Height="1" Background="#FF3A3A40"/>
                            <Grid ColumnDefinitions="Auto,*">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FF6666FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Normal Output" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Border Height="28" Background="#FF1D1D22" BorderThickness="1" BorderBrush="#FF3A3A40" CornerRadius="2" Margin="0,4,0,0">
                                <TextBlock Text="None" Foreground="#FF6A6A76" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PBR Shader Output Node -->
                    <Border Style="{StaticResource NodeStyle}" Canvas.Left="340" Canvas.Top="140" Padding="8" BorderBrush="#FF4A90E2" BorderThickness="2">
                        <StackPanel Spacing="4">
                            <TextBlock Text="PBR Shader" FontWeight="SemiBold" Foreground="#FF4A90E2" FontSize="11"/>
                            <Border Height="1" Background="#FF4A90E2"/>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Stroke="#FF4A90E2" StrokeThickness="2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Base Color" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Stroke="#FF4A90E2" StrokeThickness="2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Metallic" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Stroke="#FF4A90E2" StrokeThickness="2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Roughness" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Stroke="#FF4A90E2" StrokeThickness="2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Normal" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Stroke="#FF4A90E2" StrokeThickness="2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Emissive" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Stroke="#FF4A90E2" StrokeThickness="2" Fill="Transparent" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Opacity" Foreground="#FF8A8A96" FontSize="10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Connection lines (simplified with Line) -->
                    <Line X1="220" Y1="100" X2="340" Y2="195" Stroke="#FF4A90E2" StrokeThickness="2" StrokeDashArray="4,2"/>
                    <Line X1="220" Y1="280" X2="340" Y2="215" Stroke="#FF66CC66" StrokeThickness="2" StrokeDashArray="4,2"/>
                    <Line X1="220" Y1="310" X2="340" Y2="235" Stroke="#FF6666FF" StrokeThickness="2" StrokeDashArray="4,2"/>
                </Canvas>
            </Grid>

            <!-- Right: Property Details -->
            <Border Grid.Column="2" Background="{StaticResource YamaPanelBrush}" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Details" FontWeight="SemiBold" Foreground="{StaticResource YamaAccentBrush}" FontSize="13"/>
                        <TextBlock x:Name="DetailTitle" Text="Select a node or parameter" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11"/>

                        <Border Height="1" Background="{StaticResource YamaBorderBrush}" Margin="0,4"/>

                        <!-- UV Settings -->
                        <TextBlock Text="UV Settings" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox x:Name="UVChannelCombo" SelectedIndex="0" Margin="0,2">
                            <ComboBoxItem Content="UV Channel 0"/>
                            <ComboBoxItem Content="UV Channel 1"/>
                            <ComboBoxItem Content="UV Channel 2"/>
                            <ComboBoxItem Content="World Space"/>
                            <ComboBoxItem Content="Triplanar"/>
                        </ComboBox>

                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Tiling X" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="TilingX" Value="1" Minimum="0.01" SmallChange="0.1" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="Tiling Y" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="TilingY" Value="1" Minimum="0.01" SmallChange="0.1" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="Offset X" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="OffsetX" Value="0" SmallChange="0.01" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="Offset Y" Foreground="{StaticResource YamaTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <NumberBox Grid.Column="1" x:Name="OffsetY" Value="0" SmallChange="0.01" SpinButtonPlacementMode="Inline"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource YamaBorderBrush}" Margin="0,8"/>

                        <!-- Advanced -->
                        <TextBlock Text="Advanced" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <CheckBox x:Name="SRGBCheck" Content="sRGB" IsChecked="True" Margin="0,2"/>
                        <CheckBox x:Name="AlphaMaskCheck" Content="Use Alpha as Mask" IsChecked="False" Margin="0,2"/>

                        <!-- Texture info -->
                        <Border Height="1" Background="{StaticResource YamaBorderBrush}" Margin="0,8"/>
                        <TextBlock Text="Texture Info" Foreground="{StaticResource YamaSubTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TexInfoSize" Text="Resolution: --" Foreground="{StaticResource YamaTextBrush}" FontSize="11"/>
                        <TextBlock x:Name="TexInfoFormat" Text="Format: --" Foreground="{StaticResource YamaTextBrush}" FontSize="11"/>
                        <TextBlock x:Name="TexInfoMemory" Text="Memory: --" Foreground="{StaticResource YamaTextBrush}" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
