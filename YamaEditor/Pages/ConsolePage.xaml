<Page
    x:Class="YamaEditor.Pages.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YamaEditor.Pages">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource YamaPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="FilterLog" Content="Log" IsChecked="True" Click="FilterToggle_Click" MinWidth="52" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0"/>
                    <ToggleButton x:Name="FilterWarning" Content="Warning" IsChecked="True" Click="FilterToggle_Click" MinWidth="68" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0"/>
                    <ToggleButton x:Name="FilterError" Content="Error" IsChecked="True" Click="FilterToggle_Click" MinWidth="52" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0"/>
                    <ToggleButton x:Name="FilterInfo" Content="Info" IsChecked="True" Click="FilterToggle_Click" MinWidth="46" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0"/>
                    <Button Content="Clear" Click="Clear_Click" MinWidth="52" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="2" x:Name="SearchBox" PlaceholderText="Search..." Width="180" FontSize="11" Padding="4,2" Background="{StaticResource YamaInputBrush}" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="1" TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Log List -->
        <ListView Grid.Row="1" x:Name="LogListView"
                  SelectionMode="Extended"
                  DoubleTapped="LogListView_DoubleTapped"
                  RightTapped="LogListView_RightTapped"
                  FontFamily="Consolas"
                  FontSize="11"
                  Background="Transparent"
                  BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" Padding="4,2" BorderThickness="0,0,0,1" BorderBrush="#FF2A2A30">
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0">
                            <FontIcon.Foreground>
                                <SolidColorBrush Color="{Binding IconColor}"/>
                            </FontIcon.Foreground>
                        </FontIcon>
                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="#FF6A6A76" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Width="72"/>
                        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource YamaSubTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Width="80"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#FFB0B0B8" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FF1C1C20" BorderBrush="{StaticResource YamaBorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Foreground="#FF66CC66" FontSize="10"><Run Text="Log: "/><Run x:Name="LogCountValue" Text="0"/></TextBlock>
                <TextBlock Foreground="#FFCCCC44" FontSize="10"><Run Text="Warning: "/><Run x:Name="WarningCountValue" Text="0"/></TextBlock>
                <TextBlock Foreground="#FFCC6666" FontSize="10"><Run Text="Error: "/><Run x:Name="ErrorCountValue" Text="0"/></TextBlock>
                <TextBlock Foreground="#FF6699CC" FontSize="10"><Run Text="Info: "/><Run x:Name="InfoCountValue" Text="0"/></TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>
