<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>YamaEditor</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <!-- 使用自定义 Program.Main 入口，禁用 WinUI 自动生成的入口点 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <GeneratePriFile>false</GeneratePriFile>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- 编辑器通过 YamaEngine 的 Vulkan 后端渲染，不再直接依赖 D3D12 -->
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Core" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.22.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YamaEngine\YamaEngine.csproj" />
    <ProjectReference Include="..\BlenderBridge\BlenderBridge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude all XAML by default, then include explicitly -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="**\*.xaml" />
    <None Include="**\*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <!-- Application & Window -->
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />

    <!-- Theme -->
    <Page Include="Themes\DarkTheme.xaml" />

    <!-- Custom Controls -->
    <Page Include="Controls\EngineViewport.xaml" />

    <!-- Pages -->
    <Page Include="Pages\OutlinerPage.xaml" />
    <Page Include="Pages\ContentBrowserPage.xaml" />
    <Page Include="Pages\InspectorPage.xaml" />
    <Page Include="Pages\ConsolePage.xaml" />
    <Page Include="Pages\MaterialEditorPage.xaml" />
    <Page Include="Pages\SequenceEditorPage.xaml" />

    <!-- Dialogs -->
    <Page Include="Dialogs\NewProjectDialog.xaml" />
    <Page Include="Dialogs\SettingsDialog.xaml" />
  </ItemGroup>

  <!-- shaderc 原生库复制到输出目录（VulkanShaderCompiler P/Invoke 需要） -->
  <Target Name="CopyShadercNative" AfterTargets="Build">
    <PropertyGroup>
      <!-- Path.Combine 兼容 NuGetPackageRoot 末尾有无反斜杠两种情况 -->
      <ShadercNativeDll>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'silk.net.shaderc.native', '2.22.0', 'runtimes', 'win-x64', 'native', 'shaderc_shared.dll'))</ShadercNativeDll>
    </PropertyGroup>
    <Copy SourceFiles="$(ShadercNativeDll)"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
